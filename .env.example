# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

DATABASE_URL="postgresql://rehearsify:rehearsify_dev_password@localhost:5432/rehearsify?schema=public"

PORT=3000

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

JOB_LOOKAHEAD_DAYS=7
# Cron expression for the weekly planning job (default: every Sunday at 6 PM local time)
JOB_CRON_SCHEDULE="0 18 * * 0"

EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="rehearsify@example.com"

# SMTP transport (leave SMTP_HOST empty to use JSON transport for dev/test)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

CHOIR_SKILL_LEVEL=3
ROTATION_WINDOW_DAYS=42
